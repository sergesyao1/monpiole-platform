{
  "name": "@monpiole/tenant-management",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "migration:generate": "drizzle-kit generate --config drizzle.config.ts --name tenant_management_change",
    "migration:check": "drizzle-kit check --config drizzle.config.ts"
  },
  "dependencies": {
    "@monpiole/events": "workspace:*",
    "@monpiole/persistence": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0"
  }
}
