        }
      },
      "checkConstraints": {
        "properties_title_length_check": {
          "name": "properties_title_length_check",
          "value": "char_length(\"property_management\".\"properties\".\"title\") BETWEEN 1 AND 200"
        },
        "properties_description_length_check": {
          "name": "properties_description_length_check",
          "value": "\"property_management\".\"properties\".\"description\" IS NULL OR char_length(\"property_management\".\"properties\".\"description\") <= 5000"
        },
        "properties_type_check": {
          "name": "properties_type_check",
          "value": "\"property_management\".\"properties\".\"property_type\" IN ('APARTMENT', 'HOUSE', 'LAND', 'COMMERCIAL', 'OTHER')"
        },
        "properties_transaction_type_check": {
          "name": "properties_transaction_type_check",
          "value": "\"property_management\".\"properties\".\"transaction_type\" IN ('LONG_TERM_RENTAL', 'SHORT_TERM_RENTAL', 'SALE')"
        },
        "properties_status_check": {
          "name": "properties_status_check",
          "value": "\"property_management\".\"properties\".\"status\" IN ('DRAFT', 'PUBLISHED')"
        },
        "properties_country_check": {
          "name": "properties_country_check",
          "value": "\"property_management\".\"properties\".\"country\" ~ '^[A-Z]{2}$'"
        },
        "properties_details_values_check": {
          "name": "properties_details_values_check",
          "value": "\n    (\"property_management\".\"properties\".\"usable_surface_square_meters\" IS NULL OR (\"property_management\".\"properties\".\"usable_surface_square_meters\" > 0 AND \"property_management\".\"properties\".\"usable_surface_square_meters\" < 'Infinity'::double precision))\n    AND (\"property_management\".\"properties\".\"rooms\" IS NULL OR \"property_management\".\"properties\".\"rooms\" >= 0)\n    AND (\"property_management\".\"properties\".\"bedrooms\" IS NULL OR \"property_management\".\"properties\".\"bedrooms\" >= 0)\n    AND (\"property_management\".\"properties\".\"bathrooms\" IS NULL OR \"property_management\".\"properties\".\"bathrooms\" >= 0)\n    AND (\"property_management\".\"properties\".\"rooms\" IS NULL OR \"property_management\".\"properties\".\"bedrooms\" IS NULL OR \"property_management\".\"properties\".\"bedrooms\" <= \"property_management\".\"properties\".\"rooms\")\n  "
        },
        "properties_commercial_terms_check": {
          "name": "properties_commercial_terms_check",
          "value": "\n    (\"property_management\".\"properties\".\"commercial_kind\" IS NULL AND \"property_management\".\"properties\".\"currency\" IS NULL\n      AND \"property_management\".\"properties\".\"usable_surface_square_meters\" IS NULL AND \"property_management\".\"properties\".\"rooms\" IS NULL AND \"property_management\".\"properties\".\"bedrooms\" IS NULL AND \"property_management\".\"properties\".\"bathrooms\" IS NULL AND \"property_management\".\"properties\".\"furnished\" IS NULL\n      AND \"property_management\".\"properties\".\"rent_amount_minor\" IS NULL AND \"property_management\".\"properties\".\"rent_period\" IS NULL AND \"property_management\".\"properties\".\"security_deposit_amount_minor\" IS NULL\n      AND \"property_management\".\"properties\".\"charges_amount_minor\" IS NULL AND \"property_management\".\"properties\".\"rate_amount_minor\" IS NULL AND \"property_management\".\"properties\".\"pricing_unit\" IS NULL AND \"property_management\".\"properties\".\"sale_price_amount_minor\" IS NULL)\n    OR\n    ((\"property_management\".\"properties\".\"usable_surface_square_meters\" IS NOT NULL OR \"property_management\".\"properties\".\"rooms\" IS NOT NULL OR \"property_management\".\"properties\".\"bedrooms\" IS NOT NULL OR \"property_management\".\"properties\".\"bathrooms\" IS NOT NULL OR \"property_management\".\"properties\".\"furnished\" IS NOT NULL)\n      AND \"property_management\".\"properties\".\"currency\" ~ '^[A-Z]{3}$'\n      AND (\n        (\"property_management\".\"properties\".\"commercial_kind\" = 'LONG_TERM_RENTAL' AND \"property_management\".\"properties\".\"transaction_type\" = 'LONG_TERM_RENTAL'\n          AND \"property_management\".\"properties\".\"rent_amount_minor\" BETWEEN 0 AND 9007199254740991 AND \"property_management\".\"properties\".\"rent_period\" = 'MONTH'\n          AND (\"property_management\".\"properties\".\"security_deposit_amount_minor\" IS NULL OR \"property_management\".\"properties\".\"security_deposit_amount_minor\" BETWEEN 0 AND 9007199254740991)\n          AND (\"property_management\".\"properties\".\"charges_amount_minor\" IS NULL OR \"property_management\".\"properties\".\"charges_amount_minor\" BETWEEN 0 AND 9007199254740991)\n          AND \"property_management\".\"properties\".\"rate_amount_minor\" IS NULL AND \"property_management\".\"properties\".\"pricing_unit\" IS NULL AND \"property_management\".\"properties\".\"sale_price_amount_minor\" IS NULL)\n        OR (\"property_management\".\"properties\".\"commercial_kind\" = 'SHORT_TERM_RENTAL' AND \"property_management\".\"properties\".\"transaction_type\" = 'SHORT_TERM_RENTAL'\n          AND \"property_management\".\"properties\".\"rate_amount_minor\" BETWEEN 0 AND 9007199254740991 AND \"property_management\".\"properties\".\"pricing_unit\" IN ('NIGHT', 'WEEK')\n          AND \"property_management\".\"properties\".\"rent_amount_minor\" IS NULL AND \"property_management\".\"properties\".\"rent_period\" IS NULL AND \"property_management\".\"properties\".\"security_deposit_amount_minor\" IS NULL\n          AND \"property_management\".\"properties\".\"charges_amount_minor\" IS NULL AND \"property_management\".\"properties\".\"sale_price_amount_minor\" IS NULL)\n        OR (\"property_management\".\"properties\".\"commercial_kind\" = 'SALE' AND \"property_management\".\"properties\".\"transaction_type\" = 'SALE'\n          AND \"property_management\".\"properties\".\"sale_price_amount_minor\" BETWEEN 0 AND 9007199254740991\n          AND \"property_management\".\"properties\".\"rent_amount_minor\" IS NULL AND \"property_management\".\"properties\".\"rent_period\" IS NULL AND \"property_management\".\"properties\".\"security_deposit_amount_minor\" IS NULL\n          AND \"property_management\".\"properties\".\"charges_amount_minor\" IS NULL AND \"property_management\".\"properties\".\"rate_amount_minor\" IS NULL AND \"property_management\".\"properties\".\"pricing_unit\" IS NULL)\n      ))\n  "
        },
        "properties_structural_role_check": {
          "name": "properties_structural_role_check",
          "value": "\"property_management\".\"properties\".\"structural_role\" IN ('STANDALONE', 'COMPOSITE', 'UNIT')"
        },
        "properties_publication_state_check": {
          "name": "properties_publication_state_check",
          "value": "\n    (\"property_management\".\"properties\".\"status\" = 'DRAFT' AND \"property_management\".\"properties\".\"published_at\" IS NULL AND \"property_management\".\"properties\".\"published_by_actor_id\" IS NULL AND \"property_management\".\"properties\".\"publication_correlation_id\" IS NULL)\n    OR\n    (\"property_management\".\"properties\".\"status\" = 'PUBLISHED' AND \"property_management\".\"properties\".\"published_at\" IS NOT NULL AND \"property_management\".\"properties\".\"published_by_actor_id\" IS NOT NULL\n      AND \"property_management\".\"properties\".\"publication_correlation_id\" IS NOT NULL AND \"property_management\".\"properties\".\"commercial_kind\" IS NOT NULL)\n  "
        }
      },
      "isRLSEnabled": true
    },
