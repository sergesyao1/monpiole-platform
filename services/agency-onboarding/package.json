    "migration:check": "drizzle-kit check --config drizzle.config.ts"
  },
  "dependencies": {
    "@monpiole/persistence": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0"
  }
}