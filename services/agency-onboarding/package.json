{
  "name": "@monpiole/agency-onboarding",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
