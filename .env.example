# Copy this file to .env for local development. Do not store secrets here.
MONPIOLE_ENV=development
MONPIOLE_LOG_LEVEL=info
DATABASE_URL=postgresql://monpiole:monpiole@localhost:5432/monpiole
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# Public OIDC contract expected by the API. Replace with the development Auth0
# tenant coordinates; these values are not secrets.
AUTHENTICATION_ISSUER=https://monpiole-local.eu.auth0.com/
AUTHENTICATION_AUDIENCE=https://api.monpiole.local
AUTHENTICATION_JWKS_URI=https://monpiole-local.eu.auth0.com/.well-known/jwks.json
AUTHENTICATION_JWT_ALGORITHM=RS256
AUTHENTICATION_CLOCK_TOLERANCE_SECONDS=30
AUTHENTICATION_MAX_TOKEN_AGE_SECONDS=900
