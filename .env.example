# Copy this file to .env for local development. Do not store secrets here.
MONPIOLE_ENV=development
MONPIOLE_LOG_LEVEL=info
DATABASE_URL=postgresql://monpiole:monpiole@localhost:5432/monpiole
DATABASE_TLS=disabled
DATABASE_MIGRATION_URL=postgresql://monpiole:monpiole@localhost:5432/monpiole
DATABASE_MIGRATION_TLS=disabled
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# Public OIDC contract expected by the API. Replace with the development Auth0
# tenant coordinates; these values are not secrets.
AUTHENTICATION_ISSUER=https://monpiole-local.eu.auth0.com/
AUTHENTICATION_AUDIENCE=https://api.monpiole.local
AUTHENTICATION_JWKS_URI=https://monpiole-local.eu.auth0.com/.well-known/jwks.json
AUTHENTICATION_JWT_ALGORITHM=RS256
AUTHENTICATION_CLOCK_TOLERANCE_SECONDS=30
AUTHENTICATION_MAX_TOKEN_AGE_SECONDS=900
API_ALLOWED_BROWSER_ORIGINS=http://localhost:5173

# Catalogue public TASK-058. Vide par défaut : aucun tenant n'est exposé.
# En environnement contrôlé seulement, utiliser des entrées host=tenantUuid séparées par des virgules.
PUBLIC_CATALOG_HOST_TENANT_ALLOWLIST=
# Lorsque l'allowlist est non vide, ce pool séparé est obligatoire et doit utiliser exactement
# le login PostgreSQL monpiole_public_catalog_reader provisionné hors migration.
# PUBLIC_CATALOG_DATABASE_URL=postgresql://monpiole_public_catalog_reader:replace-locally@localhost:5432/monpiole
# PUBLIC_CATALOG_DATABASE_TLS=disabled
# PUBLIC_CATALOG_DATABASE_POOL_MAX=5
# PUBLIC_CATALOG_DATABASE_CONNECTION_TIMEOUT_MS=5000
# PUBLIC_CATALOG_DATABASE_IDLE_TIMEOUT_MS=30000

# Operator-only external identity link inputs belong in an ignored local environment.
# EXTERNAL_IDENTITY_ISSUER=https://monpiole-local.eu.auth0.com/
# EXTERNAL_IDENTITY_SUBJECT=auth0|replace-with-development-subject
# EXTERNAL_IDENTITY_INTERNAL_ID=00000000-0000-4000-8000-000000000000
# EXTERNAL_IDENTITY_TENANT_ID=00000000-0000-4000-8000-000000000000

# One-shot operator-only first installation. Put actual values in ignored local state.
# INITIAL_PLATFORM_BOOTSTRAP_ENABLED=true
# INITIAL_PLATFORM_BOOTSTRAP_CONFIRMATION=INITIALIZE_EMPTY_MONPIOLE_PLATFORM
# INITIAL_PLATFORM_BOOTSTRAP_OPERATOR_ID=local-installation-operator
# INITIAL_PLATFORM_BOOTSTRAP_IDEMPOTENCY_KEY=initial-platform-20260826
# INITIAL_PLATFORM_ORGANIZATION_NAME=MonPiole Development
# INITIAL_PLATFORM_RESPONSIBLE_PERSON_NAME=Development Operator
