  "paths": {
    "/api/v1/contract-baseline": {
      "post": {
        "operationId": "proveContractBaseline",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Correlation-Id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Tenant-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractBaselineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractBaselineResponse"
                }
              }
            },
            "description": "Validated technical echo response",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "RFC 9457 validation problem"
          }
        },
        "security": [],
        "summary": "Prove the TD-006 transport technology baseline",
        "tags": [
          "Contract baseline"
        ]
      }
    },
