{
  "components": {
    "schemas": {
      "ContractBaselineRequest": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ContractBaselineResponse": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "additionalProperties": false,
            "properties": {
              "correlationId": {
                "$ref": "#/components/schemas/CorrelationId"
              },
              "idempotencyKey": {
                "$ref": "#/components/schemas/IdempotencyKey"
              },
              "requestId": {
                "$ref": "#/components/schemas/RequestId"
              },
              "tenantId": {
                "$ref": "#/components/schemas/TenantId"
              }
            },
            "required": [
              "correlationId",
              "idempotencyKey",
              "requestId",
              "tenantId"
            ],
            "type": "object"
          },
          "message": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "context",
          "message"
        ],
        "type": "object"
      },
      "CorrelationId": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
      },
      "IdempotencyKey": {
        "pattern": "^[A-Za-z0-9._~:+-]{1,255}$",
        "type": "string"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "$ref": "#/components/schemas/CorrelationId"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemDetailsError"
            },
            "type": "array"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "code",
          "correlationId",
          "status",
          "title",
          "type"
        ],
        "type": "object"
      },
      "ProblemDetailsError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path"
        ],
        "type": "object"
      },
      "RequestId": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
      },
      "TenantId": {
        "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
        "type": "string"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Versioned MonPiole HTTP transport contracts",
    "title": "MonPiole Public API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/contract-baseline": {
      "post": {
        "operationId": "proveContractBaseline",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Correlation-Id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Tenant-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractBaselineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractBaselineResponse"
                }
              }
            },
            "description": "Validated technical echo response",
            "headers": {
              "X-Correlation-Id": {
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "RFC 9457 validation problem"
          }
        },
        "security": [],
        "summary": "Prove the TD-006 transport technology baseline",
        "tags": [
          "Contract baseline"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
