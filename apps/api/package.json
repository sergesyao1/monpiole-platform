{
  "name": "@monpiole/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "openapi": "corepack pnpm run build && node dist/openapi/generate-openapi.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@monpiole/identity": "workspace:*",
    "@monpiole/persistence": "workspace:*",
    "@monpiole/tenant-management": "workspace:*",
    "@nestjs/common": "11.2.2",
    "@nestjs/core": "11.2.2",
    "@nestjs/platform-express": "11.2.2",
    "@nestjs/swagger": "11.4.7",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  }
}
