{
  "name": "@monpiole/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "architecture:check": "node tools/quality/architecture-check.mjs",
    "architecture:graph": "depcruise --config tools/quality/dependency-cruiser.config.mjs apps services packages",
    "typecheck:architecture-fixtures": "tsc --build tools/quality/fixtures/resolver/tsconfig.json",
    "app:api:build": "corepack pnpm --filter @monpiole/api build",
    "app:api:start": "corepack pnpm --filter @monpiole/api start",
    "app:api:typecheck": "corepack pnpm --filter @monpiole/api typecheck",
    "app:api:openapi": "corepack pnpm --filter @monpiole/api openapi",
    "app:api:contracts:check": "vitest run --project contract",
    "app:web:dev": "corepack pnpm --filter @monpiole/web dev",
    "app:web:build": "corepack pnpm --filter @monpiole/web build",
    "app:web:typecheck": "corepack pnpm --filter @monpiole/web typecheck",
    "app:web:test": "corepack pnpm --filter @monpiole/web test",
    "package:events:build": "corepack pnpm --filter @monpiole/events build",
    "package:events:typecheck": "corepack pnpm --filter @monpiole/events typecheck",
    "package:events:contracts:check": "vitest run --project contract tests/contract/event-envelope.test.ts tests/contract/event-compatibility.test.ts tests/contract/event-serialization.test.ts tests/contract/tenant-created-event.test.ts tests/contract/tenant-activated-event.test.ts",
    "package:persistence:build": "corepack pnpm --filter @monpiole/persistence build",
    "package:persistence:typecheck": "corepack pnpm --filter @monpiole/persistence typecheck",
    "package:persistence:test:integration": "corepack pnpm --filter @monpiole/persistence test:integration",
    "package:persistence:migration:check": "corepack pnpm --filter @monpiole/persistence migration:check",
    "service:tenant-management:build": "corepack pnpm --filter @monpiole/tenant-management build",
    "service:tenant-management:typecheck": "corepack pnpm --filter @monpiole/tenant-management typecheck",
    "service:tenant-management:migration:check": "corepack pnpm --filter @monpiole/tenant-management migration:check",
    "service:identity:build": "corepack pnpm --filter @monpiole/identity build",
    "service:identity:typecheck": "corepack pnpm --filter @monpiole/identity typecheck",
    "service:identity:migration:check": "corepack pnpm --filter @monpiole/identity migration:check",
    "service:identity:test:integration": "corepack pnpm --filter @monpiole/identity test:integration",
    "service:property-management:build": "corepack pnpm --filter @monpiole/property-management build",
    "service:property-management:typecheck": "corepack pnpm --filter @monpiole/property-management typecheck",
    "service:property-management:migration:check": "corepack pnpm --filter @monpiole/property-management migration:check",
    "service:property-management:test:integration": "corepack pnpm --filter @monpiole/property-management test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test": "vitest run",
    "test:coverage": "vitest run --project unit --coverage",
    "typecheck:tests": "tsc --project tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "jose": "6.2.10",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
